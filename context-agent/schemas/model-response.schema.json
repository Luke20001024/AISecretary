{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memento.local/schemas/context-agent/model-response.schema.json",
  "title": "Memento Context Agent model response",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "candidate"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "status": {"const": "no_candidate"},
        "candidate": {"type": "null"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "candidate"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "status": {"const": "candidate"},
        "candidate": {"$ref": "#/$defs/candidate"}
      }
    }
  ],
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "scope",
        "why_now",
        "category",
        "sensitive",
        "uncertainty",
        "evidence"
      ],
      "properties": {
        "statement": {"type": "string", "minLength": 1, "maxLength": 400},
        "scope": {"type": "string", "minLength": 1, "maxLength": 160},
        "why_now": {"type": "string", "minLength": 1, "maxLength": 400},
        "category": {
          "enum": ["project_decision", "constraint", "work_preference"]
        },
        "sensitive": {"const": false},
        "uncertainty": {"enum": ["low", "medium"]},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line", "quote"],
      "properties": {
        "file": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.md$"},
        "line": {"type": "integer", "minimum": 1},
        "quote": {"type": "string", "minLength": 1}
      }
    }
  }
}
