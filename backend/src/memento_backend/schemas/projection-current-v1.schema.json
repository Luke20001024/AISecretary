{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memento.local/schemas/projection-current-v1.schema.json",
  "title": "Projection Current Pointer V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "publication_id", "publication_sha256", "publication_path", "sequence", "bundle_id", "bundle_sha256", "manifest_path", "published_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "memento_projection_current"},
    "publication_id": {"type": "string", "pattern": "^pub_[0-9a-f]{24}$"},
    "publication_sha256": {"$ref": "#/$defs/sha256"},
    "publication_path": {"type": "string", "pattern": "^projections/publications/[0-9]{12}-pub_[0-9a-f]{24}\\.json$"},
    "sequence": {"type": "integer", "minimum": 1},
    "bundle_id": {"type": "string", "pattern": "^prjb_[0-9a-f]{24}$"},
    "bundle_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_path": {"type": "string", "pattern": "^projections/bundles/prjb_[0-9a-f]{24}/manifest\\.json$"},
    "published_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
