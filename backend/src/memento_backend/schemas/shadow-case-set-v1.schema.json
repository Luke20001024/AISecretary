{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memento.local/schemas/shadow-case-set-v1.schema.json",
  "title": "Memento Shadow Case Set V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "case_set_id", "snapshot_ref", "created_at", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "memento_shadow_case_set"},
    "case_set_id": {"type": "string", "pattern": "^shcs_[0-9a-f]{24}$"},
    "snapshot_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "snapshot_sha256"],
      "properties": {
        "snapshot_id": {"type": "string", "pattern": "^snp_[0-9a-f]{24}$"},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "inputs", "expected_links", "allowed_inferences", "should_stop", "checks"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$"},
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256", "byte_size"],
              "properties": {
                "path": {"type": "string", "minLength": 1, "maxLength": 1024},
                "sha256": {"$ref": "#/$defs/sha256"},
                "byte_size": {"type": "integer", "minimum": 0}
              }
            }
          },
          "expected_links": {"$ref": "#/$defs/labels"},
          "allowed_inferences": {"$ref": "#/$defs/labels"},
          "should_stop": {"type": "boolean"},
          "checks": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_reference_checks", "self_traceability_checks", "resource_opinion_checks", "adapter_checks", "source_hash_checks"],
            "properties": {
              "source_reference_checks": {"$ref": "#/$defs/count"},
              "self_traceability_checks": {"$ref": "#/$defs/count"},
              "resource_opinion_checks": {"$ref": "#/$defs/count"},
              "adapter_checks": {"$ref": "#/$defs/count"},
              "source_hash_checks": {"$ref": "#/$defs/count"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "count": {"type": "integer", "minimum": 0},
    "labels": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 240}}
  }
}
