{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memento.local/schemas/resource-read-result-v1.schema.json",
  "title": "ResourceReadResult V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "result_id", "resource_ref", "source_record_ref",
    "question", "answer", "citations", "unknowns", "prompt_version",
    "policy_version", "user_action_watermark_sha256", "usage", "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "memento_resource_read_result" },
    "result_id": { "type": "string", "pattern": "^rrd_[0-9a-f]{24}$" },
    "resource_ref": { "$ref": "#/$defs/resourceRef" },
    "source_record_ref": { "$ref": "#/$defs/sourceRecordRef" },
    "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "answer": { "type": "string", "minLength": 1, "maxLength": 12000 },
    "citations": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/sourceSpan" } },
    "unknowns": { "type": "array", "maxItems": 24, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 400 } },
    "prompt_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "policy_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "user_action_watermark_sha256": { "$ref": "#/$defs/sha256" },
    "usage": { "$ref": "#/$defs/usage" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\u0000]+$" },
    "sourceRecordRef": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "revision", "revision_sha256"],
      "properties": {
        "kind": { "const": "source_record" }, "id": { "type": "string", "pattern": "^rec_[0-9a-f]{24}$" },
        "revision": { "type": "integer", "minimum": 1 }, "revision_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "resourceRef": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "revision", "revision_sha256"],
      "properties": {
        "kind": { "const": "resource_card" }, "id": { "type": "string", "pattern": "^res_[0-9a-f]{24}$" },
        "revision": { "type": "integer", "minimum": 1 }, "revision_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceSpan": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "record_revision", "record_revision_sha256", "source_file", "line_start", "line_end", "quote", "quote_sha256"],
      "properties": {
        "record_id": { "type": "string", "pattern": "^rec_[0-9a-f]{24}$" },
        "record_revision": { "type": "integer", "minimum": 1 },
        "record_revision_sha256": { "$ref": "#/$defs/sha256" },
        "source_file": { "$ref": "#/$defs/relativePath" },
        "line_start": { "type": "integer", "minimum": 1 }, "line_end": { "type": "integer", "minimum": 1 },
        "quote": { "type": "string", "minLength": 1, "maxLength": 20000 }, "quote_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "provider", "model", "attempt_status", "prompt_tokens", "completion_tokens", "total_tokens", "estimated_cost_usd", "latency_ms"],
      "properties": {
        "mode": { "enum": ["deterministic", "provider"] },
        "provider": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 80 }] },
        "model": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 160 }] },
        "attempt_status": { "enum": ["not_started", "succeeded", "failed", "unknown"] },
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "estimated_cost_usd": { "type": "number", "minimum": 0 },
        "latency_ms": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
