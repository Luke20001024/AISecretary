{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memento.local/schemas/context-pack-v1.schema.json",
  "title": "ContextPackSnapshot V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "pack_id", "session_ref", "grant_ref", "request_sha256",
    "task", "topic_scope", "time_scope", "selected_refs", "self_insights", "themes",
    "memories", "source_quotes", "unknowns", "prohibited_inferences", "allowed_writeback",
    "input_sha256", "generated_at", "expires_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "memento_context_pack_snapshot"},
    "pack_id": {"type": "string", "pattern": "^ctxp_[0-9a-f]{24}$"},
    "session_ref": {"$ref": "#/$defs/sessionRef"},
    "grant_ref": {"$ref": "#/$defs/grantRef"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "task": {"type": "string", "minLength": 1, "maxLength": 1000},
    "topic_scope": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
    "time_scope": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timeScope"}]},
    "selected_refs": {"type": "array", "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/objectRef"}},
    "self_insights": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/insight"}},
    "themes": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/theme"}},
    "memories": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/memory"}},
    "source_quotes": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/sourceQuote"}},
    "unknowns": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 600}},
    "prohibited_inferences": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 600}},
    "allowed_writeback": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"enum": ["decision", "correction", "outcome", "new_question"]}},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "generated_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "grantRef": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id", "revision", "revision_sha256"],
      "properties": {"kind": {"const": "context_grant"}, "id": {"type": "string", "pattern": "^grt_[0-9a-f]{24}$"}, "revision": {"type": "integer", "minimum": 1}, "revision_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "sessionRef": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id", "revision", "revision_sha256"],
      "properties": {"kind": {"const": "external_session"}, "id": {"type": "string", "pattern": "^ses_[0-9a-f]{24}$"}, "revision": {"type": "integer", "minimum": 1}, "revision_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "recordRef": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id", "revision", "revision_sha256"],
      "properties": {"kind": {"const": "source_record"}, "id": {"type": "string", "pattern": "^rec_[0-9a-f]{24}$"}, "revision": {"type": "integer", "minimum": 1}, "revision_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "memoryRef": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id", "revision", "revision_sha256"],
      "properties": {"kind": {"const": "memory_atom"}, "id": {"type": "string", "pattern": "^mat_[0-9a-f]{24}$"}, "revision": {"type": "integer", "minimum": 1}, "revision_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "themeRef": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id", "revision", "revision_sha256"],
      "properties": {"kind": {"const": "theme"}, "id": {"type": "string", "pattern": "^thm_[0-9a-f]{24}$"}, "revision": {"type": "integer", "minimum": 1}, "revision_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "selfInsightRef": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id", "revision", "revision_sha256"],
      "properties": {"kind": {"const": "self_insight"}, "id": {"type": "string", "pattern": "^sin_[0-9a-f]{24}$"}, "revision": {"type": "integer", "minimum": 1}, "revision_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "objectRef": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id", "revision", "revision_sha256"],
      "properties": {
        "kind": {"enum": ["source_record", "memory_atom", "theme", "self_insight"]},
        "id": {"type": "string", "pattern": "^(rec|mat|thm|sin)_[0-9a-f]{24}$"},
        "revision": {"type": "integer", "minimum": 1}, "revision_sha256": {"$ref": "#/$defs/sha256"}
      },
      "oneOf": [
        {"$ref": "#/$defs/recordRef"}, {"$ref": "#/$defs/memoryRef"},
        {"$ref": "#/$defs/themeRef"}, {"$ref": "#/$defs/selfInsightRef"}
      ]
    },
    "timeScope": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"type": "string", "format": "date"}, "to": {"type": "string", "format": "date"}}},
    "insight": {
      "type": "object", "additionalProperties": false, "required": ["ref", "title", "statement", "scope", "uncertainty", "theme_refs", "boundary_refs"],
      "properties": {
        "ref": {"$ref": "#/$defs/selfInsightRef"}, "title": {"type": "string"}, "statement": {"type": "string"}, "scope": {"type": "string"}, "uncertainty": {"type": "string"},
        "theme_refs": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/themeRef"}},
        "boundary_refs": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/memoryRef"}}
      }
    },
    "theme": {
      "type": "object", "additionalProperties": false, "required": ["ref", "title", "statement", "scope", "evidence_refs", "counterevidence_refs"],
      "properties": {
        "ref": {"$ref": "#/$defs/themeRef"}, "title": {"type": "string"}, "statement": {"type": "string"}, "scope": {"type": "string"},
        "evidence_refs": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/memoryRef"}},
        "counterevidence_refs": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/memoryRef"}}
      }
    },
    "memory": {
      "type": "object", "additionalProperties": false, "required": ["ref", "statement", "memory_kind", "topics", "purposes", "uncertainty"],
      "properties": {
        "ref": {"$ref": "#/$defs/memoryRef"}, "statement": {"type": "string"}, "memory_kind": {"type": "string"},
        "topics": {"type": "array", "items": {"type": "string"}}, "purposes": {"type": "array", "items": {"type": "string"}}, "uncertainty": {"type": "string"}
      }
    },
    "sourceQuote": {
      "type": "object", "additionalProperties": false, "required": ["record_ref", "source_file", "line_start", "line_end", "quote", "quote_sha256"],
      "properties": {
        "record_ref": {"$ref": "#/$defs/recordRef"}, "source_file": {"type": "string", "minLength": 1},
        "line_start": {"type": "integer", "minimum": 1}, "line_end": {"type": "integer", "minimum": 1},
        "quote": {"type": "string", "minLength": 1, "maxLength": 2000}, "quote_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
