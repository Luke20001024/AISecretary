{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memento.local/schemas/run-result-v1.schema.json",
  "title": "Run Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "result_id", "request_id", "request_sha256", "status", "reason_code", "agent_run_ids", "committed_refs", "finished_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "memento_run_result"},
    "result_id": {"type": "string", "pattern": "^rrs_[0-9a-f]{24}$"},
    "request_id": {"type": "string", "pattern": "^rrq_[0-9a-f]{24}$"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["completed", "failed", "rejected", "conflict"]},
    "reason_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "agent_run_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^run_[0-9a-f]{24}$"}},
    "committed_refs": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/objectRef"}},
    "finished_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "revision_sha256"],
      "properties": {
        "kind": {"enum": ["source_record", "capture_decision", "resource_card", "read_later_intent", "record_interpretation", "memory_atom", "relation", "theme", "self_insight"]},
        "id": {"type": "string", "pattern": "^(rec|cap|res|rli|int|mat|rel|thm|sin)_[0-9a-f]{24}$"},
        "revision": {"type": "integer", "minimum": 1},
        "revision_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
