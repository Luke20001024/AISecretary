{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://memento.local/schemas/record-detail-projection-v1.schema.json",
  "title": "RecordDetailProjection V1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "projection_version", "projection_id", "bundle_id", "generated_at", "as_of", "input_sha256", "record_ref", "source", "interpretation", "memory_atom_refs", "theme_refs"],
  "properties": {
    "schema_version": {"const": "1.0"}, "kind": {"const": "memento_record_detail_projection"}, "projection_version": {"const": "memento-record-detail-v1"},
    "projection_id": {"type": "string", "pattern": "^rdt_[0-9a-f]{24}$"}, "bundle_id": {"$ref": "#/$defs/bundleId"}, "generated_at": {"type": "string", "format": "date-time"}, "as_of": {"type": "string", "format": "date"}, "input_sha256": {"$ref": "#/$defs/sha256"},
    "record_ref": {"$ref": "#/$defs/sourceRecordRef"},
    "source": {"type": "object", "additionalProperties": false, "required": ["captured_at", "local_date", "source_type", "source_app", "source_file", "line_start", "line_end", "attachment_refs"], "properties": {"captured_at": {"type": "string", "format": "date-time"}, "local_date": {"type": "string", "format": "date"}, "source_type": {"type": "string", "minLength": 1, "maxLength": 80}, "source_app": {"type": "string", "minLength": 1, "maxLength": 200}, "source_file": {"type": "string", "minLength": 1, "maxLength": 500}, "line_start": {"type": "integer", "minimum": 1}, "line_end": {"type": "integer", "minimum": 1}, "attachment_refs": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 500}}}},
    "interpretation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/interpretation"}]},
    "memory_atom_refs": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/memoryAtomRef"}},
    "theme_refs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/themeRef"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bundleId": {"type": "string", "pattern": "^prjb_[0-9a-f]{24}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "revision", "revision_sha256"], "properties": {"kind": {"enum": ["source_record", "record_interpretation", "memory_atom", "theme"]}, "id": {"type": "string", "pattern": "^(rec|int|mat|thm)_[0-9a-f]{24}$"}, "revision": {"type": "integer", "minimum": 1}, "revision_sha256": {"$ref": "#/$defs/sha256"}}, "allOf": [{"if": {"properties": {"kind": {"const": "source_record"}}}, "then": {"properties": {"id": {"pattern": "^rec_"}}}}, {"if": {"properties": {"kind": {"const": "record_interpretation"}}}, "then": {"properties": {"id": {"pattern": "^int_"}}}}, {"if": {"properties": {"kind": {"const": "memory_atom"}}}, "then": {"properties": {"id": {"pattern": "^mat_"}}}}, {"if": {"properties": {"kind": {"const": "theme"}}}, "then": {"properties": {"id": {"pattern": "^thm_"}}}}]},
    "sourceRecordRef": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"kind": {"const": "source_record"}}}]},
    "interpretationRef": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"kind": {"const": "record_interpretation"}}}]},
    "memoryAtomRef": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"kind": {"const": "memory_atom"}}}]},
    "themeRef": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"kind": {"const": "theme"}}}]},
    "sourceSpan": {"type": "object", "additionalProperties": false, "required": ["record_id", "record_revision", "record_revision_sha256", "source_file", "line_start", "line_end", "quote", "quote_sha256"], "properties": {"record_id": {"type": "string", "pattern": "^rec_[0-9a-f]{24}$"}, "record_revision": {"type": "integer", "minimum": 1}, "record_revision_sha256": {"$ref": "#/$defs/sha256"}, "source_file": {"type": "string", "minLength": 1, "maxLength": 500}, "line_start": {"type": "integer", "minimum": 1}, "line_end": {"type": "integer", "minimum": 1}, "quote": {"type": "string", "minLength": 1, "maxLength": 2000}, "quote_sha256": {"$ref": "#/$defs/sha256"}}},
    "interpretation": {"type": "object", "additionalProperties": false, "required": ["interpretation_ref", "status", "summary", "content_types", "topics", "purposes", "stance", "uncertainty", "source_spans"], "properties": {"interpretation_ref": {"$ref": "#/$defs/interpretationRef"}, "status": {"enum": ["ready", "needs_review", "original_only"]}, "summary": {"type": "string", "maxLength": 600}, "content_types": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}}, "topics": {"type": "array", "maxItems": 24, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}}, "purposes": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}}, "stance": {"type": "string", "minLength": 1, "maxLength": 80}, "uncertainty": {"type": "string", "minLength": 1, "maxLength": 80}, "source_spans": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/sourceSpan"}}}}
  }
}
