{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memento.local/schemas/capture-decision-v1.schema.json",
  "title": "CaptureDecisionRevision V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "decision_id",
    "revision",
    "previous_revision_sha256",
    "status",
    "operation",
    "source_record_ref",
    "content_role",
    "processing_route",
    "user_signal_spans",
    "resource_scope",
    "reason_code",
    "confidence",
    "needs_user_confirmation",
    "prompt_version",
    "policy_version",
    "user_action_watermark_sha256",
    "created_at",
    "committed_by"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "memento_capture_decision_revision" },
    "decision_id": { "type": "string", "pattern": "^cap_[0-9a-f]{24}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "previous_revision_sha256": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
    },
    "status": { "enum": ["active", "tombstone"] },
    "operation": { "enum": ["route", "user_override", "source_superseded", "tombstone"] },
    "source_record_ref": { "$ref": "#/$defs/sourceRecordRef" },
    "content_role": {
      "enum": ["personal_signal", "resource", "read_later", "mixed", "archive_only", "external_trace", "ambiguous"]
    },
    "processing_route": {
      "enum": ["interpret", "resource_index", "ask_on_use", "resource_index_and_interpret", "archive_only", "needs_confirmation"]
    },
    "user_signal_spans": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/sourceSpan" }
    },
    "resource_scope": { "enum": ["none", "selected_spans", "whole_resource"] },
    "reason_code": {
      "enum": [
        "explicit_user_judgment",
        "explicit_read_later_intent",
        "resource_without_user_signal",
        "highlighted_user_signal",
        "external_trace",
        "ambiguous_input",
        "user_override"
      ]
    },
    "confidence": { "enum": ["low", "medium", "high"] },
    "needs_user_confirmation": { "type": "boolean" },
    "prompt_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "policy_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "user_action_watermark_sha256": { "$ref": "#/$defs/sha256" },
    "created_at": { "type": "string", "format": "date-time" },
    "committed_by": { "enum": ["workflow", "user", "migration"] }
  },
  "allOf": [
    {
      "if": { "properties": { "revision": { "const": 1 } } },
      "then": { "properties": { "previous_revision_sha256": { "type": "null" } } },
      "else": { "properties": { "previous_revision_sha256": { "$ref": "#/$defs/sha256" } } }
    },
    {
      "if": { "properties": { "content_role": { "const": "read_later" } } },
      "then": {
        "properties": {
          "processing_route": { "const": "ask_on_use" },
          "reason_code": { "const": "explicit_read_later_intent" }
        }
      }
    },
    {
      "if": { "properties": { "content_role": { "const": "resource" } } },
      "then": {
        "properties": {
          "processing_route": { "enum": ["resource_index", "ask_on_use"] }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "tombstone" } } },
      "then": { "properties": { "operation": { "const": "tombstone" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\u0000]+$"
    },
    "sourceRecordRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "revision_sha256"],
      "properties": {
        "kind": { "const": "source_record" },
        "id": { "type": "string", "pattern": "^rec_[0-9a-f]{24}$" },
        "revision": { "type": "integer", "minimum": 1 },
        "revision_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "record_revision",
        "record_revision_sha256",
        "source_file",
        "line_start",
        "line_end",
        "quote",
        "quote_sha256"
      ],
      "properties": {
        "record_id": { "type": "string", "pattern": "^rec_[0-9a-f]{24}$" },
        "record_revision": { "type": "integer", "minimum": 1 },
        "record_revision_sha256": { "$ref": "#/$defs/sha256" },
        "source_file": { "$ref": "#/$defs/relativePath" },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "quote": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "quote_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
