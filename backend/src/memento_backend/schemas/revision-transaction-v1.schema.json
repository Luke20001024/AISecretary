{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memento.local/schemas/revision-transaction-v1.schema.json",
  "title": "Revision Transaction V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "transaction_id", "generation", "previous_transaction_sha256", "committed_at", "members"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "memento_revision_transaction"},
    "transaction_id": {"type": "string", "pattern": "^rtx_[0-9a-f]{24}$"},
    "generation": {"type": "integer", "minimum": 1},
    "previous_transaction_sha256": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
    },
    "committed_at": {"type": "string", "format": "date-time"},
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_kind", "object_id", "ref", "path"],
        "properties": {
          "object_kind": {"$ref": "#/$defs/formalKind"},
          "object_id": {"type": "string", "pattern": "^(rec|cap|res|rli|int|mat|rel|thm|sin|grt|ses|aud|xtr)_[0-9a-f]{24}$"},
          "ref": {"$ref": "#/$defs/objectRef"},
          "path": {"type": "string", "pattern": "^[a-z-]+/revisions/[A-Za-z0-9_-]+\\.r[0-9]{6}\\.json$"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "formalKind": {
      "enum": ["source_record", "capture_decision", "resource_card", "read_later_intent", "record_interpretation", "memory_atom", "relation", "theme", "self_insight", "context_grant", "external_session", "context_read_audit", "external_trace"]
    },
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "revision_sha256"],
      "properties": {
        "kind": {"$ref": "#/$defs/formalKind"},
        "id": {"type": "string", "pattern": "^(rec|cap|res|rli|int|mat|rel|thm|sin|grt|ses|aud|xtr)_[0-9a-f]{24}$"},
        "revision": {"type": "integer", "minimum": 1},
        "revision_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
