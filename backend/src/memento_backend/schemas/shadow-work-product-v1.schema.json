{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memento.local/schemas/shadow-work-product-v1.schema.json",
  "title": "Memento Shadow Work Product V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "work_product_id", "plan_ref", "case_set_ref", "snapshot_ref", "producer", "started_at", "finished_at", "predictions", "candidate_bundle_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "memento_shadow_work_product"},
    "work_product_id": {"type": "string", "pattern": "^shw_[0-9a-f]{24}$"},
    "plan_ref": {"$ref": "#/$defs/plan_ref"},
    "case_set_ref": {"$ref": "#/$defs/case_set_ref"},
    "snapshot_ref": {"$ref": "#/$defs/snapshot_ref"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_mode", "provider", "model", "prompt_versions", "policy_versions"],
      "properties": {
        "execution_mode": {"enum": ["deterministic_zero", "provider_shadow"]},
        "provider": {"type": ["string", "null"], "minLength": 1},
        "model": {"type": ["string", "null"], "minLength": 1},
        "prompt_versions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "policy_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "predictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "predicted_links", "predicted_inferences", "did_stop", "valid_source_references", "valid_self_traces", "resource_as_user_errors", "stale_resurrections", "adapter_passes", "stable_source_hashes", "usage"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$"},
          "predicted_links": {"$ref": "#/$defs/labels"},
          "predicted_inferences": {"$ref": "#/$defs/labels"},
          "did_stop": {"type": "boolean"},
          "valid_source_references": {"$ref": "#/$defs/count"},
          "valid_self_traces": {"$ref": "#/$defs/count"},
          "resource_as_user_errors": {"$ref": "#/$defs/count"},
          "stale_resurrections": {"$ref": "#/$defs/count"},
          "adapter_passes": {"$ref": "#/$defs/count"},
          "stable_source_hashes": {"$ref": "#/$defs/count"},
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "provider", "model", "attempt_status", "prompt_tokens", "completion_tokens", "total_tokens", "estimated_cost_usd", "latency_ms"],
            "properties": {
              "mode": {"enum": ["deterministic", "provider"]},
              "provider": {"type": ["string", "null"], "minLength": 1},
              "model": {"type": ["string", "null"], "minLength": 1},
              "attempt_status": {"enum": ["not_started", "succeeded", "failed", "unknown"]},
              "prompt_tokens": {"$ref": "#/$defs/count"},
              "completion_tokens": {"$ref": "#/$defs/count"},
              "total_tokens": {"$ref": "#/$defs/count"},
              "estimated_cost_usd": {"type": "number", "minimum": 0},
              "latency_ms": {"$ref": "#/$defs/count"}
            }
          }
        }
      }
    },
    "candidate_bundle_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "count": {"type": "integer", "minimum": 0},
    "labels": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
    "plan_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "plan_sha256"],
      "properties": {
        "plan_id": {"type": "string", "pattern": "^shp_[0-9a-f]{24}$"},
        "plan_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "case_set_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["case_set_id", "case_set_sha256"],
      "properties": {
        "case_set_id": {"type": "string", "pattern": "^shcs_[0-9a-f]{24}$"},
        "case_set_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "snapshot_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_id", "snapshot_sha256"],
      "properties": {
        "snapshot_id": {"type": "string", "pattern": "^snp_[0-9a-f]{24}$"},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
